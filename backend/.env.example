# NeonDB bağlantı string'i (Vercel'de environment variable olarak ekle)
DATABASE_URL=postgresql://neondb_owner:...@ep-...pooler.neon.tech/neondb?sslmode=require

# JWT için rastgele uzun bir şifre (en az 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Opsiyonel: CORS için izin verilen domain
ALLOWED_ORIGIN=*
